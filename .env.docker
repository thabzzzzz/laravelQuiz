# Docker environment helper file — do NOT commit secrets to repo for production.
# Use this file as a reference for Docker development. Copy to `.env` when booting the
# development stack locally: `cp .env.docker .env` or edit as needed.

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret

# Node/Vite
VITE_APP_NAME="${APP_NAME}"
